#!/usr/bin/env bash
# Compatibility wrapper for the former task-oriented public path.
# It delegates to milestone-brief and does not restore fresh-agent-per-task
# topology. New callers should use milestone-brief directly.
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"

if [ $# -eq 2 ]; then
  plan=$1
  n=$2
  dir=$("$script_dir/sdd-workspace" "$plan")
  exec "$script_dir/milestone-brief" "$plan" "$n" "$dir/task-${n}-brief.md"
fi

exec "$script_dir/milestone-brief" "$@"
