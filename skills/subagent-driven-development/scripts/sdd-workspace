#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for one plan's
# short-lived artifacts: task briefs, implementer reports, review packages,
# and the progress ledger. Print the plan directory's absolute path.
#
# One directory per plan (.superpowers/sdd/<plan-basename>/) so a follow-up
# plan in the same working tree can never read or overwrite another plan's
# artifacts. A stale ledger misread as current progress makes controllers
# skip whole task sequences — plan-scoping removes that failure structurally.
#
# Basename slugs collide when two plans share a filename (docs/alpha/plan.md
# vs docs/beta/plan.md), so each workspace records its owning plan's path in
# a plan-path marker (repo-relative in-repo, absolute outside). A workspace
# owned by a different plan is skipped and the slug disambiguated with the
# plan's parent-directory name, then a counter. A workspace with no marker
# predates the marker scheme and is adopted for the current plan so in-flight
# workspaces keep resolving — which means the first collision on such a
# legacy workspace adopts instead of detecting; acceptable, marker-less
# workspaces age out as plans finish.
#
# The workspace lives in the working tree (not under .git/) because Claude Code
# treats .git/ as a protected path and denies agent writes there — which blocks
# an implementer subagent from writing its report file. A self-ignoring
# .gitignore at .superpowers/sdd/ keeps every plan's workspace out of
# `git status` and out of accidental commits without modifying any tracked file.
#
# Single source of truth for the workspace location, so task-brief and
# review-package cannot drift to different directories.
#
# The repository is the current directory's (see sdd-repo). -C DIR runs as
# if started in DIR, the way git -C does: a caller working on another
# checkout or worktree needs no `cd DIR ;` prefix, a compound that harnesses
# cannot allowlist because DIR differs on every run (#1799).
#
# Usage: sdd-workspace [-C DIR] PLAN_FILE
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
if [ "${1:-}" = "-C" ]; then
  [ -d "${2:-}" ] || { echo "bad -C directory: ${2:-}" >&2; exit 2; }
  cd "$2"
  shift 2
fi

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace [-C DIR] PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

# Physical path, spelled the way pwd -P spells the plan path below: on Git
# Bash, rev-parse prints C:/Users/... while pwd prints /c/Users/..., and the
# repo-relative marker check needs both in the same form. Two steps, so a
# failing sdd-repo stops the script instead of handing cd an empty path.
# Invoke via bash rather than direct exec: some extractors (Python zipfile)
# strip Unix exec bits when unpacking marketplace packages (#2040).
toplevel=$("${BASH:-bash}" "$here/sdd-repo")
root=$(CDPATH='' cd -- "$toplevel" && pwd -P)
base="$root/.superpowers/sdd"

# Normalize the plan path (physical directory, so relative/absolute/../
# spellings of one plan compare equal) and express it as the marker value:
# repo-relative when the plan lives under the repo root, absolute otherwise.
plan_dir=$(CDPATH='' cd -- "$(dirname "$plan")" && pwd -P)
plan_abs="$plan_dir/$(basename "$plan")"
case "$plan_abs" in
  "$root"/*) plan_id=${plan_abs#"$root"/} ;;
  *)         plan_id=$plan_abs ;;
esac

# True when the workspace at $1 is (or becomes) this plan's: an existing
# marker must name this plan; a missing marker means a new workspace or a
# pre-marker legacy one, and either way the plan claims it by writing one.
#
# owns() distinguishes "this plan's" (0) from "another plan's" (1) from
# "unusable" (2: mkdir/printf failed, or the marker cannot be read). The
# caller loop must treat a failure as a reason to stop, never as a slot to
# try next: with `set -e` suspended inside a `while ! owns ...` condition,
# an unwritable workspace spun the slug counter forever (a regular file at
# .superpowers reproduced 800+ iterations in 8s before exiting via timeout).
#
# claim_marker() is the single place that writes and classifies the marker,
# so both the fresh-directory and the existing-directory paths agree. Two
# controllers claiming one slug race on the marker: only the noclobber
# winner's write lands, and the loser reads what it finds — this plan's
# marker means it may adopt the workspace, another plan's means try the next
# slot. A write that fails for any other reason leaves a marker that cannot
# be read, which is the only "unusable" case.
claim_marker() {
  if ( set -C; printf '%s\n' "$plan_id" > "$1/plan-path" ) 2>/dev/null; then
    return 0
  fi
  # The noclobber winner creates plan-path and then writes the line, so a
  # read that lands in between sees an empty file. Retry briefly: an empty
  # read is not another plan's marker, and treating it as one would split
  # this plan across two slots. A marker that stays empty is a crashed
  # winner's residue and still counts as another plan's, as before.
  local val="" try
  for try in 1 2 3; do
    val=$(cat "$1/plan-path" 2>/dev/null) \
      || { echo "cannot read marker in $1 after a failed marker write" >&2; return 2; }
    if [ -n "$val" ]; then break; fi
    if [ "$try" -lt 3 ]; then sleep 0.05; fi
  done
  [ "$val" = "$plan_id" ] && return 0 || return 1
}

owns() {
  if [ -e "$1/plan-path" ]; then
    claim_marker "$1" || return $?
    return 0
  fi
  if ! mkdir -p "$(dirname "$1")" 2>/dev/null; then
    echo "cannot create workspace base $(dirname "$1")" >&2; return 2
  fi
  if ! mkdir "$1" 2>/dev/null && [ ! -d "$1" ]; then
    echo "cannot create workspace $1" >&2; return 2
  fi
  claim_marker "$1" || return $?
  return 0
}

claim() {
  owns "$1"; rc=$?
  case $rc in
    0|1) return "$rc" ;;
    *) exit 2 ;;
  esac
}

dir="$base/$slug"
if ! claim "$dir"; then
  parent=$(basename "$plan_dir")
  dir="$base/$slug-$parent"
  if ! claim "$dir"; then
    n=2
    dir=""
    while [ "$n" -le 32 ]; do
      if claim "$base/$slug-$parent-$n"; then dir="$base/$slug-$parent-$n"; break; fi
      n=$((n + 1))
    done
    [ -n "$dir" ] || { echo "no free workspace for $slug under $base after 32 attempts" >&2; exit 2; }
  fi
fi

# Create-only: a repo may commit its own .gitignore here (e.g. to version
# progress.md ledgers); overwriting it would revert that on every run.
[ -e "$base/.gitignore" ] || printf '*\n' > "$base/.gitignore"

# On Windows (Git Bash, MSYS2, Cygwin) print C:/Users/... rather than
# /c/Users/... or /tmp/...: the caller may be PowerShell or another native
# tool, which can't resolve MSYS paths, and bash accepts this form too.
# Only the printed path changes; the plan-path markers above keep pwd -P's
# spelling, so existing workspaces still match their plans.
CDPATH='' cd -- "$dir"
if command -v cygpath >/dev/null 2>&1; then cygpath -m "$PWD"; else pwd; fi
