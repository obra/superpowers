#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for one plan's
# artifacts: task briefs, implementer reports, review packages, and progress ledger.
# Print the plan directory's absolute path.
#
# Usage: sdd-workspace [-C DIR] PLAN_FILE
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
if [ "${1:-}" = "-C" ]; then
  [ -d "${2:-}" ] || { echo "bad -C directory: ${2:-}" >&2; exit 2; }
  cd "$2"
  shift 2
fi

if [ $# -ne 1 ] || [ -z "$1" ]; then
  echo "usage: sdd-workspace [-C DIR] PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ ! -e "$plan" ] || [ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }
# .lock and .lock.* (any case) belong to the claim lock below, not a workspace.
slug_lc=$(printf '%s' "$slug" | tr '[:upper:]' '[:lower:]')
case "$slug_lc" in
  .lock|.lock.*) slug="plan-${slug#.}" ;;
esac

# Physical path, spelled the way pwd -P spells the plan path below: on Git
# Bash, rev-parse prints C:/Users/... while pwd prints /c/Users/..., and the
# repo-relative marker check needs both in the same form. Two steps, so a
# failing sdd-repo stops the script instead of handing cd an empty path.
# Invoke via bash rather than direct exec: some extractors (Python zipfile)
# strip Unix exec bits when unpacking marketplace packages (#2040).
toplevel=$("${BASH:-bash}" "$here/sdd-repo")
root=$(CDPATH='' cd -- "$toplevel" && pwd -P)
base="$root/.superpowers/sdd"

# Normalize the plan path (physical directory, so relative/absolute/../
# spellings of one plan compare equal) and express it as the marker value:
# repo-relative when the plan lives under the repo root, absolute otherwise.
# Collapse lexical . and .. segments, then walk up to the deepest existing ancestor
# so deleted plans under removed subdirectories still resolve their claimed workspace.
case "$plan" in
  /*|[A-Za-z]:/*) raw_abs=$plan ;;
  *) raw_abs="$(pwd -P)/$plan" ;;
esac

IFS=/ read -r -a raw_parts <<< "$raw_abs"
parts=()
for seg in "${raw_parts[@]}"; do
  case "$seg" in
    ""|.) continue ;;
    ..) [ ${#parts[@]} -gt 0 ] && unset "parts[$((${#parts[@]} - 1))]" || true ;;
    *) parts+=("$seg") ;;
  esac
done

lex_abs=""
for seg in "${parts[@]+"${parts[@]}"}"; do
  case "$lex_abs" in
    ""|[A-Za-z]:) lex_abs="${lex_abs}${lex_abs:+/}$seg" ;;
    *) lex_abs="$lex_abs/$seg" ;;
  esac
done
[ -n "$lex_abs" ] || lex_abs="/"
case "$raw_abs" in
  [A-Za-z]:/*) ;;
  *) [ "${lex_abs#/}" != "$lex_abs" ] || lex_abs="/$lex_abs" ;;
esac

plan_base=${lex_abs##*/}
probe=${lex_abs%/*}
[ -n "$probe" ] || probe="/"
tail=""
while [ ! -d "$probe" ]; do
  seg=${probe##*/}
  tail="${seg}${tail:+/$tail}"
  parent_probe=${probe%/*}
  [ -n "$parent_probe" ] || parent_probe="/"
  [ "$parent_probe" = "$probe" ] && break
  probe=$parent_probe
done
[ -d "$probe" ] || { echo "no such plan file: $plan" >&2; exit 2; }

probe_phys=$(CDPATH='' cd -- "$probe" && pwd -P)
[ "$probe_phys" = "/" ] && probe_phys=""
plan_dir="${probe_phys}${tail:+/$tail}"
[ -n "$plan_dir" ] || plan_dir="/"
plan_abs="$plan_dir/$plan_base"
case "$plan_abs" in
  "$root"/*) plan_id=${plan_abs#"$root"/} ;;
  *)         plan_id=$plan_abs ;;
esac

parent=$(basename "$plan_dir")

print_dir() {
  CDPATH='' cd -- "$1"
  if command -v cygpath >/dev/null 2>&1; then cygpath -m "$PWD"; else pwd; fi
}

find_claimed() {
  local cand="$base/$slug"
  if [ -f "$cand/plan-path" ] && [ "$(cat "$cand/plan-path")" = "$plan_id" ]; then
    printf '%s\n' "$cand"; return 0
  fi
  cand="$base/$slug-$parent"
  if [ -f "$cand/plan-path" ] && [ "$(cat "$cand/plan-path")" = "$plan_id" ]; then
    printf '%s\n' "$cand"; return 0
  fi
  local n=2
  while [ "$n" -le 100 ]; do
    cand="$base/$slug-$parent-$n"
    if [ -f "$cand/plan-path" ] && [ "$(cat "$cand/plan-path")" = "$plan_id" ]; then
      printf '%s\n' "$cand"; return 0
    fi
    n=$((n + 1))
  done
  return 1
}

if [ ! -f "$plan_abs" ]; then
  if [ -d "$base" ] && dir=$(find_claimed); then
    print_dir "$dir"
    exit 0
  fi
  echo "no such plan file: $plan" >&2
  exit 2
fi

mkdir -p "$base" 2>/dev/null && [ -d "$base" ] && [ -w "$base" ] \
  || { echo "sdd-workspace: $base is not a writable directory" >&2; exit 2; }

locked=0
cleanup_lock() { [ "$locked" -eq 1 ] && rm -rf "$base/.lock"; }
trap cleanup_lock EXIT

tries=0
empty_polls=0
while ! mkdir "$base/.lock" 2>/dev/null; do
  if [ -f "$base/.lock/pid" ]; then
    lpid=$(cat "$base/.lock/pid" 2>/dev/null || true)
    empty_polls=0
    if [ -n "$lpid" ] && ! kill -0 "$lpid" 2>/dev/null; then
      if mv "$base/.lock" "$base/.lock.stale.$$" 2>/dev/null; then
        rm -rf "$base/.lock.stale.$$"
        continue
      fi
    fi
  else
    empty_polls=$((empty_polls + 1))
    if [ "$empty_polls" -ge 50 ] && mv "$base/.lock" "$base/.lock.stale.$$" 2>/dev/null; then
      rm -rf "$base/.lock.stale.$$"
      empty_polls=0
      continue
    fi
  fi
  tries=$((tries + 1))
  [ "$tries" -lt 1000 ] || { echo "sdd-workspace: timed out waiting for $base/.lock" >&2; exit 2; }
  sleep 0.02 2>/dev/null || sleep 1
done
locked=1
{ printf '%s\n' "$$" > "$base/.lock/pid"; } 2>/dev/null || true

[ -e "$base/.gitignore" ] || printf '*\n' > "$base/.gitignore"

# True when the workspace at $1 is (or becomes) this plan's: an existing
# marker must name this plan; a missing marker means a new workspace or a
# pre-marker legacy one, and either way the plan claims it by writing one.
claim_candidate() {
  local cand=$1
  if [ ! -e "$cand" ]; then
    mkdir -p "$cand"
    printf '%s\n' "$plan_id" > "$cand/plan-path"
    dir=$cand
    return 0
  fi
  if [ -d "$cand" ]; then
    if [ -f "$cand/plan-path" ]; then
      [ "$(cat "$cand/plan-path")" = "$plan_id" ] && { dir=$cand; return 0; }
    else
      printf '%s\n' "$plan_id" > "$cand/plan-path"
      dir=$cand
      return 0
    fi
  fi
  return 1
}

dir=""
if ! claim_candidate "$base/$slug" && ! claim_candidate "$base/$slug-$parent"; then
  n=2
  while [ "$n" -le 100 ]; do
    claim_candidate "$base/$slug-$parent-$n" && break
    n=$((n + 1))
  done
fi

[ -n "$dir" ] || { echo "sdd-workspace: exceeded 100 workspace candidates for $slug" >&2; exit 2; }
print_dir "$dir"
