#!/usr/bin/env bash
# Print the top-level directory of the git working tree the SDD scripts use
# for PLAN_FILE: the current directory's, or, when the current directory is
# not inside a git working tree, the plan's own.
#
# The current directory wins because an executor working in a linked
# worktree commonly holds an absolute path to the plan in the main checkout
# (writing-plans leaves the plan uncommitted there), and its workspace and
# commits belong to the worktree it is working in. A caller that means a
# different working tree says so with the scripts' -C DIR.
#
# The plan's repository is the fallback for a caller whose current directory
# is outside any repository, such as the skill's own directory in an
# installed plugin. With neither, there is nothing to hold the workspace, so
# stop rather than guess a directory. --with-commit also stops on a
# repository with no commit yet, for callers that need HEAD as a BASE or a
# review range. The message covers both ways to get here: running from the
# wrong directory (where 'git init' would be the wrong fix) and a new
# project that has no repository or commit yet.
#
# Single source of truth for which repository the SDD and executing-plans
# scripts work in, so no two of them can disagree.
#
# Usage: sdd-repo [--with-commit] PLAN_FILE
set -euo pipefail

with_commit=false
if [ "${1:-}" = "--with-commit" ]; then
  with_commit=true
  shift
fi

if [ $# -ne 1 ]; then
  echo "usage: sdd-repo [--with-commit] PLAN_FILE" >&2
  exit 2
fi

plan=$1

root=$(git rev-parse --show-toplevel 2>/dev/null) \
  || root=$(git -C "$(dirname "$plan")" rev-parse --show-toplevel 2>/dev/null) \
  || root=""

if [ -n "$root" ] && { [ "$with_commit" = false ] || git -C "$root" rev-parse --verify --quiet HEAD >/dev/null; }; then
  printf '%s\n' "$root"
  exit 0
fi

echo "SDD scripts must run from inside the git working tree you're executing in, with at least one commit (current directory: $PWD). If this is a new project, run 'git init' and make a first commit, then rerun." >&2
exit 2
