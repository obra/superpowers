#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

# Resolve the repository that owns PLAN_FILE, not the caller's cwd: matches
# sdd-workspace's resolution exactly, so the workspace, the BASE/HEAD
# revisions, and the diff all refer to the same repository even when this
# is invoked from a different git worktree than the one holding the plan
# (#2429). Falls back to the caller's cwd only when the plan itself is not
# inside any git repository.
plan_dir_raw=$(dirname "$plan")
root=$(git -C "$plan_dir_raw" rev-parse --show-toplevel 2>/dev/null) \
  || root=$(git rev-parse --show-toplevel)
root=$(CDPATH='' cd -- "$root" && pwd -P)

git -C "$root" rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git -C "$root" rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

# Range guards (exit 3): a wrong-branch HEAD yields a range that is empty or
# not rooted at BASE; either would silently produce a bogus review package.
git -C "$root" merge-base --is-ancestor "$base" "$head" || { echo "HEAD is not a descendant of BASE: ${base}..${head}" >&2; exit 3; }
[ "$(git -C "$root" rev-list --count "${base}..${head}")" -gt 0 ] || { echo "empty commit range: ${base}..${head}" >&2; exit 3; }

if [ $# -eq 4 ]; then
  out=$4
else
  # Invoke via bash rather than direct exec: some extractors (Python zipfile)
  # strip Unix exec bits when unpacking marketplace packages (#2040).
  dir=$("${BASH:-bash}" "$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-$(git -C "$root" rev-parse --short "$base")..$(git -C "$root" rev-parse --short "$head").diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git -C "$root" log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git -C "$root" diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git -C "$root" diff -U10 "${base}..${head}"
} > "$out"

commits=$(git -C "$root" rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
