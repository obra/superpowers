{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ACE_ROOT}/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-context.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${ACE_ROOT}/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/inbox-notify.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ACE_ROOT}/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-trace.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${ACE_ROOT}/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-execution-memory.py\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|WebFetch|WebSearch|CallMcpTool",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ACE_ROOT}/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-trace.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ACE_ROOT}/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-auto-test.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ACE_ROOT}/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-trace.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ACE_ROOT}/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-recall.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${ACE_ROOT}/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/detect-frustration.py\" --fast",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${ACE_ROOT}/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/detect-frustration.py\"",
            "timeout": 30,
            "asyncRewake": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ACE_ROOT}/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-reflect.py\"",
            "async": true,
            "timeout": 120
          },
          {
            "type": "command",
            "command": "\"${ACE_ROOT}/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-doctor.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ACE_ROOT}/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end-cleanup.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
