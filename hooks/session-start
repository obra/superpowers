#!/usr/bin/env bash
# SessionStart hook for the toolbelt plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Claude Code passes the trigger on stdin as {"source": "startup|resume|clear|compact"}.
# After a compaction the harness re-injects the invoked skills itself, so the
# full using-toolbelt text would be paid twice; inject a pointer instead.
source=""
hook_input=""
if [ ! -t 0 ]; then
  IFS= read -r -t 2 -d '' hook_input || true
  source=$(printf '%s' "$hook_input" | sed -n 's/.*"source"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' | head -n 1)
fi

if [ "$source" = "compact" ]; then
  using_toolbelt_content="Context was just compacted. Your toolbelt rules still apply: invoke a relevant skill before acting, route subagents by the AGENT-ROUTING text (or the agent-routing skill's bundled default when none is loaded), and continue from the ledger or handoff you were keeping rather than re-reading whole plans or specs. Re-invoke a skill only when its instructions are no longer in your context."
else
  # Read using-toolbelt content
  using_toolbelt_content=$(cat "${PLUGIN_ROOT}/skills/using-toolbelt/SKILL.md" 2>&1 || echo "Error reading using-toolbelt skill")
fi

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_toolbelt_escaped=$(escape_for_json "$using_toolbelt_content")
session_context="<TOOLBELT>\nYou have a toolbelt.\n\n**Below is the full content of your 'toolbelt:using-toolbelt' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_toolbelt_escaped}\n</TOOLBELT>"

# Output context injection as JSON.
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Codex and other SDK-standard harnesses expect additionalContext (top-level).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  # Codex or unknown platform — SDK standard format
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
