+# The brief is the task's text plus the plan's shared header: every section
+# before Task 1 (goal, architecture, global constraints, file structure), so
+# a task need not repeat what the plan states once for all tasks.
 awk -v n="$n" '
   /^```/ { infence = !infence }
   !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
     intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
