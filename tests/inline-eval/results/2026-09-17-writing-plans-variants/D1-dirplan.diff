diff --git a/skills/executing-plans/scripts/plan-boundary b/skills/executing-plans/scripts/plan-boundary
new file mode 100755
index 0000000..1c10d64
--- /dev/null
+++ b/skills/executing-plans/scripts/plan-boundary
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# Check the next plan against the code as built before starting it. Collects
+# every backticked identifier in the plan's task-level `Consumes` lines (the
+# Plan Set section lists other plans' consumption and is skipped), drops the ones this plan itself produces
+# (its `Produces` lines and the functions/types its code blocks define), and
+# reports each remaining name that does not occur in the repository's source
+# outside plans/ and docs/. A hit is a plan that says what the code does not:
+# fix the plan, re-run until it prints "boundary: clean".
+#
+# Usage: plan-boundary PLAN_FILE
+# Exit: 0 when clean, 1 when any consumed name is missing, 2 on usage error.
+set -euo pipefail
+[ $# -eq 1 ] || { echo "usage: plan-boundary PLAN_FILE" >&2; exit 2; }
+plan=$1; [ -e "$plan" ] || { echo "no such plan: $plan" >&2; exit 2; }
+if [ -d "$plan" ]; then tmp=$(mktemp); cat "$plan"/00-header.md "$plan"/[0-9][0-9]-*.md > "$tmp" 2>/dev/null; planname=$(basename "$plan"); plan=$tmp; else planname=$(basename "$plan"); fi
+root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
+idents() {  # backticked spans on stdin -> identifiers, one per line; paths and files skipped
+  grep -o '`[^`]*`' | tr -d '`' | grep -v -e '/' -e '\.md$' | grep -o '[A-Za-z_][A-Za-z0-9_]*' | sort -u
+}
+stop='^(and|or|the|from|of|in|a|an|to|with|for|int|string|bool|byte|rune|error|nil|true|false|func|type|struct|var|const|Plan|Task|Tasks|plans|md|s|m|g|t|x|y|dt|None|self|str|list|dict|float|Decimal|date|datetime|time|Duration)$'
+# task-level Consumes lines, plus this plan's own entry in the Plan Set section
+# (the other entries list what other plans consume and are skipped)
+body=$(awk '/^## Plan Set/{skip=1;next} /^## /{skip=0} !skip' "$plan")
+own=$(awk '/^## Plan Set/{f=1;next} /^## /{f=0} f' "$plan" | grep -F -- "$planname" || true)
+consumes=$( { printf '%s\n' "$body" | grep -i -A8 'Consumes'; printf '%s\n' "$own"; } | idents | grep -v -E "$stop" || true)
+produces=$( { printf '%s\n' "$body" | grep -i -A8 'Produces' | idents; awk '/^```/{f=!f;next} f' "$plan" | grep -o -E '^(func(tion)? (\([^)]*\) )?[A-Za-z_][A-Za-z0-9_]*|type [A-Za-z_][A-Za-z0-9_]*|class [A-Za-z_][A-Za-z0-9_]*|def [A-Za-z_][A-Za-z0-9_]*)' | awk '{print $NF}'; } | sort -u || true)
+names=$(comm -23 <(echo "$consumes") <(echo "$produces"))
+[ -n "$names" ] || { echo "boundary: no names consumed from earlier plans in $plan"; exit 0; }
+missing=0; found=0
+while IFS= read -r n; do
+  [ -n "$n" ] || continue
+  if git -C "$root" grep -q -w -- "$n" -- ':!plans/*' ':!docs/*' ':!*.md' 2>/dev/null; then found=$((found+1)); else echo "missing in code: $n  (consumed by $plan)"; missing=1; fi
+done <<< "$names"
+[ $missing -eq 0 ] && { echo "boundary: clean ($found consumed names found in code)"; exit 0; }
+exit 1
